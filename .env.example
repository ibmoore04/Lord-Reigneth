# ============================================================
# Lord Reigneth Foods — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to version control.
# ============================================================

# ── Supabase ──────────────────────────────────────────────
# Found in your Supabase project: Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── App ───────────────────────────────────────────────────
VITE_APP_URL=https://lordreignethfoods.com

# ── Paystack (public key only — secret key NEVER goes here) ──
# VITE_PAYSTACK_PUBLIC_KEY=pk_live_...

# ============================================================
# SERVER-SIDE ONLY — these must NEVER be prefixed with VITE_
# Keep these in a secure server environment / Edge Function env
# ============================================================
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# PAYSTACK_SECRET_KEY=sk_live_...
